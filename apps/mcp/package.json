    "@gitlit/prose": "workspace:*",
    "@gitlit/provenance": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^4.21.2",
    "zod": "^3.24.1"
  },
  "devDependencies": { "@types/express": "^5.0.0" }
}
