{
  "name": "@gitlit/mcp",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "bin": { "gitlit-mcp": "./dist/stdio.js" },
  "scripts": {
    "build": "tsup src/stdio.ts src/http.ts --format esm --clean",
    "dev": "node --experimental-strip-types src/stdio.ts",
