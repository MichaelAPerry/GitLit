# --- Core ---
NODE_ENV=development
DATABASE_URL=postgresql://gitlit:gitlit@localhost:5432/gitlit
REDIS_URL=redis://localhost:6379

# --- Services ---
API_PORT=4000
GITD_PORT=4001
GITD_URL=http://localhost:4001
NEXT_PUBLIC_API_URL=http://localhost:4000

# --- Storage ---
# gitd is the ONLY process that touches this path (system_architecture.md §5)
REPO_ROOT=./repos

# --- Auth ---
AUTH_SECRET=dev-only-change-me
AUTH_URL=http://localhost:3000

# --- Signing (§7.4) ---
# Wraps per-repo Ed25519 private keys at rest. 32 bytes, base64.
# REQUIRED in production: unset, the key that signs every receipt sits in
# plaintext on the repository volume — the thing most likely to be snapshotted
# and copied around. gitd refuses to start without it.
SIGNING_MASTER_KEY=

# NOTE: there is deliberately no model API key here.
# GitLit runs no inference (§2.6). Authors connect from their own Claude.

# --- Service auth ---
# Shared secret between api/mcp and gitd. gitd refuses to start without it in
# production; without it, anyone who can reach gitd can commit as anyone.
GITD_SERVICE_TOKEN=dev-service-token-change-me

# Where gitd asks for an authorization decision on each clone and push.
# REQUIRED in production: unset, it defaults to localhost, which on a deployed
# machine is gitd itself — every clone 500s while /health stays green.
GITLIT_API_URL=http://localhost:4000

# --- Email (§4) ---
# REQUIRED in production: the API refuses to start without RESEND_API_KEY,
# because a server that starts without one accepts sign-ups, answers "a link
# is on its way", and sends nothing. Left unset in development, sign-in emails
# are printed to the API log — a real link you can complete a real sign-in with.
RESEND_API_KEY=
# Must be on a domain verified at Resend, or every send is rejected 403.
MAIL_FROM=GitLit <hello@gitlit.app>
# Optional. Where replies go; unset means replies bounce off the from address.
MAIL_REPLY_TO=

# PUBLIC_WEB_URL below is what sign-in links point at. Get it wrong and every
# emailed link lands on the wrong host.

# --- Rate limiting & monitoring (§2.5) ---
# How many proxies sit in front of the API. This decides what req.ip is, and
# the rate limiter is keyed on it. Too low: every request carries the edge
# proxy's address, so one bucket covers the whole platform and one busy author
# limits everyone. Too high: a client forges X-Forwarded-For and gets a fresh
# bucket per request, which is no limit at all. Fly puts exactly one in front.
TRUST_PROXY_HOPS=1

# Error monitoring. Unset means no monitoring and no complaint — a stack that
# refuses to run without an error tracker has made the tracker a dependency of
# the product. Everything sent is scrubbed first: no credentials, no
# addresses, no manuscript prose, and no source context.
SENTRY_DSN=

# --- OAuth providers (optional) ---
# An unconfigured provider simply does not appear on the sign-in page.
# GitLit requests identity scopes only and stores no provider access token.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
PUBLIC_API_URL=http://localhost:4000
PUBLIC_WEB_URL=http://localhost:3000
